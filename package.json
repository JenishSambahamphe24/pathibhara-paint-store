{
  "name": "pathibhara-paints",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter api dev",
    "dev:admin": "pnpm --filter admin-fe dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "format:write": "turbo run format:write",
    "check": "turbo run check",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter api db:generate",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:seed": "pnpm --filter api db:seed",
    "db:seed:sample": "pnpm --filter api db:seed:sample",
    "db:reset": "pnpm --filter api db:reset",
    "db:studio": "pnpm --filter api db:studio",
    "admin:create": "pnpm --filter api admin:create",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:generic",
    "@commitlint/config-conventional": "catalog:generic",
    "@types/node": "catalog:generic",
    "husky": "catalog:generic",
    "turbo": "catalog:generic"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "bcrypt",
      "esbuild",
      "sharp"
    ]
  },
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=22"
  }
}
