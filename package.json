{
  "name": "pathibhara-paints",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter api dev",
    "dev:admin": "pnpm --filter admin-fe dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "format:write": "turbo run format:write",
    "check": "turbo run check",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter api db:generate",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:seed": "pnpm --filter api db:seed",
    "db:seed:sample": "pnpm --filter api db:seed:sample",
    "db:reset": "pnpm --filter api db:reset",
    "db:studio": "pnpm --filter api db:studio",
    "admin:create": "pnpm --filter api admin:create",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:generic",
    "@commitlint/config-conventional": "catalog:generic",
    "@types/node": "catalog:generic",
    "husky": "catalog:generic",
    "turbo": "catalog:generic"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "bcrypt",
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "@tiptap/core": "3.22.5",
      "@tiptap/extension-blockquote": "3.22.5",
      "@tiptap/extension-bold": "3.22.5",
      "@tiptap/extension-bubble-menu": "3.22.5",
      "@tiptap/extension-bullet-list": "3.22.5",
      "@tiptap/extension-code": "3.22.5",
      "@tiptap/extension-code-block": "3.22.5",
      "@tiptap/extension-document": "3.22.5",
      "@tiptap/extension-dropcursor": "3.22.5",
      "@tiptap/extension-floating-menu": "3.22.5",
      "@tiptap/extension-gapcursor": "3.22.5",
      "@tiptap/extension-hard-break": "3.22.5",
      "@tiptap/extension-heading": "3.22.5",
      "@tiptap/extension-horizontal-rule": "3.22.5",
      "@tiptap/extension-image": "3.22.5",
      "@tiptap/extension-italic": "3.22.5",
      "@tiptap/extension-link": "3.22.5",
      "@tiptap/extension-list": "3.22.5",
      "@tiptap/extension-list-item": "3.22.5",
      "@tiptap/extension-list-keymap": "3.22.5",
      "@tiptap/extension-ordered-list": "3.22.5",
      "@tiptap/extension-paragraph": "3.22.5",
      "@tiptap/extension-placeholder": "3.22.5",
      "@tiptap/extension-strike": "3.22.5",
      "@tiptap/extension-text": "3.22.5",
      "@tiptap/extension-text-align": "3.22.5",
      "@tiptap/extension-underline": "3.22.5",
      "@tiptap/extensions": "3.22.5",
      "@tiptap/html": "3.22.5",
      "@tiptap/pm": "3.22.5",
      "@tiptap/react": "3.22.5",
      "@tiptap/starter-kit": "3.22.5"
    }
  },
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=22"
  }
}
