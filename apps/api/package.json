{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#config": "./src/config/index.ts",
    "#config/*": "./src/config/*.ts",
    "#db/*": "./src/db/*.ts",
    "#helpers/*": "./src/helpers/*.ts",
    "#i18n/*": "./src/i18n/*.ts",
    "#modules/*": "./src/modules/*"
  },
  "scripts": {
    "dev": "node --import @swc-node/register/esm-register --watch-path=src --watch-path=../../packages src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "check": "prettier --write . && eslint --fix .",
    "db:generate": "node --env-file=.env ../../packages/database/scripts/dk.mjs generate",
    "db:migrate": "node --env-file=.env --import @swc-node/register/esm-register ../../packages/database/src/migrate.ts",
    "db:seed": "node --env-file=.env --import @swc-node/register/esm-register scripts/seed.ts",
    "db:seed:sample": "node --env-file=.env --import @swc-node/register/esm-register scripts/seed-sample.ts",
    "db:reset": "node --env-file=.env --import @swc-node/register/esm-register ../../packages/database/src/reset.ts",
    "db:studio": "node --env-file=.env ../../packages/database/scripts/dk.mjs studio",
    "admin:create": "node --env-file=.env --import @swc-node/register/esm-register scripts/create-admin.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "catalog:be",
    "@repo/database": "workspace:*",
    "@repo/http-kit": "workspace:*",
    "@repo/shared": "workspace:*",
    "@scalar/express-api-reference": "catalog:be",
    "bcrypt": "catalog:be",
    "dotenv": "catalog:be",
    "drizzle-orm": "catalog:be",
    "express": "catalog:be",
    "express-rate-limit": "catalog:be",
    "i18next": "catalog:be",
    "jsonwebtoken": "catalog:be",
    "openapi3-ts": "catalog:be",
    "pg": "catalog:be",
    "pino": "catalog:be",
    "pino-http": "catalog:be",
    "pino-pretty": "catalog:be",
    "reflect-metadata": "catalog:be",
    "tsyringe": "catalog:be",
    "zod": "catalog:generic"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "catalog:generic",
    "@repo/config": "workspace:*",
    "@swc-node/register": "catalog:be",
    "@swc/core": "catalog:be",
    "@types/bcrypt": "catalog:be",
    "@types/express": "catalog:be",
    "@types/jsonwebtoken": "catalog:be",
    "@types/node": "catalog:generic",
    "@types/pg": "catalog:be",
    "@types/pino-http": "catalog:be",
    "drizzle-kit": "catalog:be",
    "eslint": "catalog:generic",
    "prettier": "catalog:generic",
    "tsup": "catalog:be",
    "typescript": "catalog:generic",
    "typescript-eslint": "catalog:generic",
    "vitest": "catalog:generic"
  }
}
