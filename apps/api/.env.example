NODE_ENV=development
PORT=4002
LOG_PRETTY=true

# docker compose: postgres://postgres:postgres@localhost:5432/pathibhara_paints
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pathibhara_paints
# Used by integration tests; must be a separate, disposable database.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/pathibhara_paints_test

# At least 32 characters each. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
BCRYPT_COST=12

# `pnpm db:seed` creates this admin if it doesn't exist.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Store Owner

CORS_ORIGINS=http://localhost:4005,http://localhost:4006
# TRUST_PROXY=1
# DOCS_PASSWORD=
